# Machine default identity. This file is created per machine and is not tracked.
#   home box:  cp config.identity.home config.identity
#   work box:  populate config.identity.work, then cp it to config.identity
[include]
	path = ~/.config/git/config.identity

# Cross-context overrides via SSH host aliases (home.* / work.*). A repo cloned
# through the "other" context's alias still commits as the right identity.
[includeIf "hasconfig:remote.*.url:git@home.github.com:*"]
	path = ~/.config/git/config.identity.home
[includeIf "hasconfig:remote.*.url:git@home.gitlab.com:*"]
	path = ~/.config/git/config.identity.home
[includeIf "hasconfig:remote.*.url:git@work.github.com:*"]
	path = ~/.config/git/config.identity.work
[includeIf "hasconfig:remote.*.url:git@work.gitlab.com:*"]
	path = ~/.config/git/config.identity.work

# Automatic personal identity scoping for just3ws repositories (SSH and HTTPS).
# hasconfig globs are path globs: `*` stops at `/` and only `/**` spans them, so
# the HTTPS form needs its scheme spelled out.
[includeIf "hasconfig:remote.*.url:*github.com:just3ws/*"]
	path = ~/.config/git/config.identity.home
[includeIf "hasconfig:remote.*.url:https://github.com/just3ws/**"]
	path = ~/.config/git/config.identity.home

# Directory-based fallback guarantees for platform repositories:
[includeIf "gitdir:~/.config/zsh/"]
	path = ~/.config/git/config.identity.home
# No trailing slash: adots is a bare repo, so its git dir IS ~/.homegit
# (a trailing slash would only match paths below it).
[includeIf "gitdir:~/.homegit"]
	path = ~/.config/git/config.identity.home
[includeIf "gitdir:~/.config/nvim/"]
	path = ~/.config/git/config.identity.home

# Machine-local commit signing (untracked; skipped when absent). See zdots
# docs/commit-signing.md.
[include]
	path = ~/.config/git/config.signing

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	autocrlf = input
	pager = delta

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[rebase]
	autosquash = true
	autostash = true

[merge]
	conflictstyle = zdiff3

[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = true
	syntax-theme = Kanagawa Wave
	minus-style = syntax "#43242B"
	minus-emph-style = syntax "#672E30"
	plus-style = syntax "#2B3328"
	plus-emph-style = syntax "#43503A"
	line-numbers-minus-style = "#C34043"
	line-numbers-plus-style = "#76946A"
	line-numbers-zero-style = "#54546D"
	file-style = "#7E9CD8" bold
	hunk-header-style = "#957FB8"
	hunk-header-decoration-style = "#54546D" box

[interactive]
	diffFilter = delta --color-only

[init]
	defaultBranch = main

[fetch]
	prune = true

[diff]
	colorMoved = default
[format]
	pretty = %C(yellow)%h%C(auto)%d %s %C(dim)%an, %ar%Creset
[log]
	date = relative
[safe]
	directory = /app
