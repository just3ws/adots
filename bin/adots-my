#!/usr/bin/env bash
# adots-my — structural supervisor for the private ~/my system.
#
# Commands:
#   adots-my doctor [--quiet] [--json] [--my-root PATH] [--strict-public-vault]
#
# This command validates paths and repository boundaries only. It must not crawl
# vault contents, generate indexes, run git add, clone, pull, or publish.

# "~/my" appears literally in user-facing check labels; the tilde is intentional
# display text, not a path to expand.
# shellcheck disable=SC2088

set -euo pipefail
trap '' PIPE

usage() {
  cat <<'EOF'
Usage: adots-my <command> [OPTIONS]

Validate the safe ~/my directory skeleton without mutating files.
This is the Rails-style migration-status check for the private my system.

Commands:
  doctor                  Read-only status check for the ~/my contract
  prepare                 Create the safe active skeleton and templates
  migrate                 Move legacy roots into ~/my/.archive with a note

Options:
  --my-root PATH          Validate PATH instead of $HOME/my
  --strict-public-vault   Treat a missing vaults/public directory as a failure
  --dry-run               Preview prepare/migrate actions without writing
  --apply                 Apply prepare/migrate actions
  --json                  Emit machine-readable JSON
  -q, --quiet             Suppress passing checks
  -h, --help              Show this help

EOF
}

json_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

MY_ROOT="${ADOTS_MY_ROOT:-${MY_HOME:-$HOME/my}}"
STRUCTURE_CONTRACT_VERSION="my.structure.v1"
STRUCTURE_MIGRATION_VERSION="my.structure.migration.v1"
EXPECTED_MY_REMOTE="github.com/just3ws/my"
QUIET=0
JSON_MODE=0
STRICT_PUBLIC_VAULT=0
DRY_RUN=0
APPLY=0
failures=0
warnings=0
passes=0
actions_planned=0
actions_applied=0
declare -a RESULTS=()

record() {
  local status="$1"
  local label="$2"
  local path="${3:-}"
  local detail="${4:-}"

  RESULTS+=("${status}|${label}|${path}|${detail}")

  case "$status" in
    ok)
      passes=$((passes + 1))
      if [[ "$QUIET" -eq 0 && "$JSON_MODE" -eq 0 ]]; then
        printf 'adots-my: ok: %s' "$label"
        [[ -n "$path" ]] && printf ' (%s)' "$path"
        printf '\n'
      fi
      ;;
    warn)
      warnings=$((warnings + 1))
      if [[ "$JSON_MODE" -eq 0 ]]; then
        printf 'adots-my: WARN %s' "$label" >&2
        [[ -n "$path" ]] && printf ' (%s)' "$path" >&2
        [[ -n "$detail" ]] && printf ' — %s' "$detail" >&2
        printf '\n' >&2
      fi
      ;;
    fail)
      failures=$((failures + 1))
      if [[ "$JSON_MODE" -eq 0 ]]; then
        printf 'adots-my: FAIL %s' "$label" >&2
        [[ -n "$path" ]] && printf ' (%s)' "$path" >&2
        [[ -n "$detail" ]] && printf ' — %s' "$detail" >&2
        printf '\n' >&2
      fi
      ;;
  esac
}

check_dir() {
  local label="$1"
  local path="$2"
  if [[ -d "$path" ]]; then
    record ok "$label" "$path"
  else
    record fail "$label missing" "$path"
  fi
}

action_line() {
  local verb="$1"
  local path="$2"
  if [[ "$QUIET" -eq 0 || "$verb" == fail* ]]; then
    printf 'adots-my: %s %s\n' "$verb" "$path"
  fi
}

ensure_dir_state() {
  local path="$1"
  local label="${2:-$path}"

  if [[ -d "$path" ]]; then
    action_line "ok: dir exists" "$label"
    return 0
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    action_line "would create dir" "$label"
    actions_planned=$((actions_planned + 1))
    return 0
  fi

  mkdir -p "$path"
  action_line "created dir" "$label"
  actions_applied=$((actions_applied + 1))
}

ensure_file_state() {
  local path="$1"
  local content="$2"
  local label="${3:-$path}"

  if [[ -f "$path" ]]; then
    action_line "ok: file exists" "$label"
    return 0
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    action_line "would write file" "$label"
    actions_planned=$((actions_planned + 1))
    return 0
  fi

  mkdir -p "$(dirname "$path")"
  printf '%s' "$content" > "$path"
  action_line "wrote file" "$label"
  actions_applied=$((actions_applied + 1))
}

ensure_my_skeleton() {
  ensure_dir_state "$MY_ROOT/.archive" "$MY_ROOT/.archive"
  ensure_dir_state "$MY_ROOT/config" "$MY_ROOT/config"
  ensure_dir_state "$MY_ROOT/docs" "$MY_ROOT/docs"
  ensure_dir_state "$MY_ROOT/docs/migrations" "$MY_ROOT/docs/migrations"
  ensure_dir_state "$MY_ROOT/context-engine" "$MY_ROOT/context-engine"
  ensure_dir_state "$MY_ROOT/knowledge" "$MY_ROOT/knowledge"
  ensure_dir_state "$MY_ROOT/knowledge/inbox" "$MY_ROOT/knowledge/inbox"
  ensure_dir_state "$MY_ROOT/knowledge/lessons" "$MY_ROOT/knowledge/lessons"
  ensure_dir_state "$MY_ROOT/knowledge/methodologies" "$MY_ROOT/knowledge/methodologies"
  ensure_dir_state "$MY_ROOT/knowledge/references" "$MY_ROOT/knowledge/references"
  ensure_dir_state "$MY_ROOT/vaults" "$MY_ROOT/vaults"
  ensure_dir_state "$MY_ROOT/vaults/personal" "$MY_ROOT/vaults/personal"
  ensure_dir_state "$MY_ROOT/vaults/public" "$MY_ROOT/vaults/public"

  ensure_file_state \
    "$MY_ROOT/config/sources.yml" \
    "version: 1
local_domain: my.localhost

archive:
  root: ~/my/.archive
  preserve_relative_path: true
  policy: inactive_unmapped_sources_only

sources:
  - id: my.context_engine
    kind: rails_service
    path: ~/my/context-engine
    visibility: internal
    active: true
    role: local_system_intelligence_and_context_api
    publish: never

  - id: my.vault.personal
    kind: obsidian_vault
    path: ~/my/vaults/personal
    visibility: private
    active: true
    role: private_personal_authoring
    publish: never

  - id: my.vault.public
    kind: obsidian_vault
    path: ~/my/vaults/public
    visibility: public_safe
    active: planned
    role: public_candidate_authoring
    publish: approval_required
" \
    "$MY_ROOT/config/sources.yml"

  # Contract self-declaration (decision-007 §3). adots-my is the authority for
  # the contract version; this file is the my repo's attestation that its
  # skeleton conforms. `adots-my doctor` verifies the declared value matches.
  ensure_file_state \
    "$MY_ROOT/config/structure.yml" \
    "# my.structure contract declaration (decision-007 §3).
# adots-my is the authority for the contract version; this file is the my
# repo's self-attestation that its skeleton conforms to that contract.
# 'adots-my doctor' verifies this declared value matches the authority.
contract: ${STRUCTURE_CONTRACT_VERSION}
" \
    "$MY_ROOT/config/structure.yml"
}

move_legacy_root_to_archive() {
  local rel="$1"
  local src="$MY_ROOT/$rel"
  local dest="$MY_ROOT/.archive/$rel"

  if [[ ! -e "$src" && ! -L "$src" ]]; then
    action_line "skip: missing" "$src"
    return 0
  fi

  if [[ -e "$dest" || -L "$dest" ]]; then
    record fail "archive collision for $rel" "$dest" "refusing to overwrite existing archive entry"
    return 1
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    action_line "would move" "$src -> $dest"
    actions_planned=$((actions_planned + 1))
    return 0
  fi

  mkdir -p "$MY_ROOT/.archive"
  mv "$src" "$dest"
  action_line "moved" "$src -> $dest"
  actions_applied=$((actions_applied + 1))
}

write_migration_note() {
  local note="$MY_ROOT/docs/migrations/${STRUCTURE_MIGRATION_VERSION}.md"
  local content="$1"

  if [[ -f "$note" ]]; then
    action_line "ok: migration note exists" "$note"
    return 0
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    action_line "would write migration note" "$note"
    actions_planned=$((actions_planned + 1))
    return 0
  fi

  mkdir -p "$(dirname "$note")"
  printf '%s' "$content" > "$note"
  action_line "wrote migration note" "$note"
  actions_applied=$((actions_applied + 1))
}

run_prepare() {
  [[ "$JSON_MODE" -eq 0 ]] || { printf 'adots-my: prepare does not support --json yet\n' >&2; return 2; }
  [[ "$DRY_RUN" -eq 1 || "$APPLY" -eq 1 ]] || DRY_RUN=1
  if [[ "$APPLY" -eq 1 && "$DRY_RUN" -eq 1 ]]; then
    printf 'adots-my: choose either --dry-run or --apply\n' >&2
    return 2
  fi

  printf 'adots-my: prepare %s (%s)\n' "$MY_ROOT" "$STRUCTURE_CONTRACT_VERSION"
  check_my_git_repo "$MY_ROOT"
  check_my_remote "$MY_ROOT"
  ensure_my_skeleton
  printf 'adots-my: summary: %d planned, %d applied, %d failure(s)\n' "$actions_planned" "$actions_applied" "$failures"
  [[ "$failures" -eq 0 ]]
}

run_migrate() {
  [[ "$JSON_MODE" -eq 0 ]] || { printf 'adots-my: migrate does not support --json yet\n' >&2; return 2; }
  [[ "$DRY_RUN" -eq 1 || "$APPLY" -eq 1 ]] || DRY_RUN=1
  if [[ "$APPLY" -eq 1 && "$DRY_RUN" -eq 1 ]]; then
    printf 'adots-my: choose either --dry-run or --apply\n' >&2
    return 2
  fi

  local moved=()
  printf 'adots-my: migrate %s (%s)\n' "$MY_ROOT" "$STRUCTURE_MIGRATION_VERSION"
  check_my_git_repo "$MY_ROOT"
  check_my_remote "$MY_ROOT"
  ensure_dir_state "$MY_ROOT/.archive" "$MY_ROOT/.archive"
  ensure_dir_state "$MY_ROOT/docs" "$MY_ROOT/docs"
  ensure_dir_state "$MY_ROOT/docs/migrations" "$MY_ROOT/docs/migrations"

  for legacy in backlog lessons methodologies standards transcripts adrs _archive; do
    if [[ -e "$MY_ROOT/$legacy" || -L "$MY_ROOT/$legacy" ]]; then
      moved+=("$legacy -> .archive/$legacy")
      move_legacy_root_to_archive "$legacy"
    fi
  done

  if [[ ${#moved[@]} -gt 0 ]]; then
    write_migration_note "# ${STRUCTURE_MIGRATION_VERSION}

Legacy roots moved into \`~/my/.archive\`:

$(for item in "${moved[@]}"; do printf -- '- %s\n' "$item"; done)
"
  else
    action_line "ok: no legacy roots found" "$MY_ROOT"
  fi

  printf 'adots-my: summary: %d planned, %d applied, %d failure(s)\n' "$actions_planned" "$actions_applied" "$failures"
  [[ "$failures" -eq 0 ]]
}

check_file() {
  local label="$1"
  local path="$2"
  if [[ -f "$path" ]]; then
    record ok "$label" "$path"
  else
    record fail "$label missing" "$path"
  fi
}

# Verify the my repo's self-declared contract version (config/structure.yml)
# matches the authority (STRUCTURE_CONTRACT_VERSION). decision-007 §3.
check_contract_declaration() {
  local decl="$MY_ROOT/config/structure.yml"
  if [[ ! -f "$decl" ]]; then
    record fail "contract declaration missing" "$decl" "run: adots-my prepare --apply"
    return
  fi

  local declared
  declared="$(sed -n 's/^[[:space:]]*contract:[[:space:]]*//p' "$decl" | head -1 | tr -d '[:space:]')"
  if [[ -z "$declared" ]]; then
    record fail "contract declaration unparseable" "$decl" "no 'contract:' key found"
  elif [[ "$declared" == "$STRUCTURE_CONTRACT_VERSION" ]]; then
    record ok "contract declaration" "$decl" "$declared"
  else
    record fail "contract declaration mismatch" "$decl" "declared=$declared expected=$STRUCTURE_CONTRACT_VERSION"
  fi
}

is_expected_my_remote() {
  local remote_url="$1"
  case "$remote_url" in
    git@github.com:just3ws/my|git@github.com:just3ws/my.git) return 0 ;;
    https://github.com/just3ws/my|https://github.com/just3ws/my.git) return 0 ;;
    ssh://git@github.com/just3ws/my|ssh://git@github.com/just3ws/my.git) return 0 ;;
    github.com:just3ws/my|github.com:just3ws/my.git) return 0 ;;
    git@*:just3ws/my|git@*:just3ws/my.git)
      # SSH host alias (e.g. work.github.com) — accept when it resolves to github.com
      local host="${remote_url#git@}"
      host="${host%%:*}"
      [[ "$(ssh -G "$host" 2>/dev/null | awk '/^hostname /{print $2; exit}')" == "github.com" ]] && return 0
      return 1 ;;
    *) return 1 ;;
  esac
}

check_my_git_repo() {
  local path="$1"
  if [[ ! -d "$path" ]]; then
    record fail "~/my root missing" "$path"
    return
  fi

  local resolved_path
  resolved_path="$(cd "$path" && pwd -P)"

  if ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    record fail "~/my is not a Git work tree" "$resolved_path"
    return
  fi

  local top
  top="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
  local resolved_top
  resolved_top="$(cd "$top" && pwd -P)"
  if [[ "$resolved_top" != "$resolved_path" ]]; then
    record fail "~/my Git top-level is not the my root" "$resolved_path" "top-level=${resolved_top:-unknown}"
    return
  fi

  local git_dir
  git_dir="$(git -C "$path" rev-parse --git-dir 2>/dev/null || true)"
  if [[ "$git_dir" == "$HOME/.homegit" || "$git_dir" == ".homegit" ]]; then
    record fail "~/my is using the adots bare repository" "$path"
    return
  fi

  record ok "~/my is a separate Git work tree" "$resolved_path"
}

check_my_remote() {
  local path="$1"
  local remote_url
  remote_url="$(git -C "$path" config --get remote.origin.url 2>/dev/null || true)"

  if [[ -z "$remote_url" ]]; then
    record fail "~/my origin remote missing" "$path" "expected $EXPECTED_MY_REMOTE"
    return
  fi

  if is_expected_my_remote "$remote_url"; then
    record ok "~/my origin points to $EXPECTED_MY_REMOTE" "$remote_url"
  else
    record fail "~/my origin remote is unexpected" "$remote_url" "expected $EXPECTED_MY_REMOTE"
  fi
}

check_not_adots_tracked() {
  local rel="my"
  local home_git="${ADOTS_REPO:-$HOME/.homegit}"

  if [[ ! -d "$home_git" ]]; then
    record warn "adots bare repo unavailable; cannot verify ~/my is untracked" "$home_git"
    return
  fi

  local tracked
  tracked="$(git --git-dir="$home_git" --work-tree="$HOME" ls-files "$rel" 2>/dev/null | head -1 || true)"
  if [[ -n "$tracked" ]]; then
    record fail "adots tracks ~/my content" "$HOME/$tracked" "remove from adots before syncing"
    return
  fi

  record ok "adots does not track ~/my content" "$MY_ROOT"
}

source_registry_defers_public_vault() {
  local sources="$MY_ROOT/config/sources.yml"
  [[ -f "$sources" ]] || return 1
  grep -Eq '^[[:space:]]*-[[:space:]]*id:[[:space:]]*my\.vault\.public[[:space:]]*$' "$sources" \
    && grep -Eq '^[[:space:]]*active:[[:space:]]*planned[[:space:]]*$' "$sources"
}

emit_json() {
  local status="pass"
  [[ "$failures" -gt 0 ]] && status="fail"

  printf '{'
  printf '"status":"%s",' "$status"
  printf '"contract_version":"%s",' "$(json_escape "$STRUCTURE_CONTRACT_VERSION")"
  printf '"expected_remote":"%s",' "$(json_escape "$EXPECTED_MY_REMOTE")"
  printf '"my_root":"%s",' "$(json_escape "$MY_ROOT")"
  printf '"passed":%d,' "$passes"
  printf '"warnings":%d,' "$warnings"
  printf '"failures":%d,' "$failures"
  printf '"checks":['

  local first=1
  local row status_field label path detail
  for row in "${RESULTS[@]}"; do
    IFS='|' read -r status_field label path detail <<<"$row"
    [[ "$first" -eq 0 ]] && printf ','
    first=0
    printf '{'
    printf '"status":"%s",' "$(json_escape "$status_field")"
    printf '"label":"%s",' "$(json_escape "$label")"
    printf '"path":"%s",' "$(json_escape "$path")"
    printf '"detail":"%s"' "$(json_escape "$detail")"
    printf '}'
  done

  printf ']}\n'
}

doctor() {
  [[ "$JSON_MODE" -eq 1 ]] || printf 'adots-my: checking %s (%s)\n' "$MY_ROOT" "$STRUCTURE_CONTRACT_VERSION"

  record ok "structure contract" "$STRUCTURE_CONTRACT_VERSION"
  check_contract_declaration
  check_my_git_repo "$MY_ROOT"
  check_my_remote "$MY_ROOT"
  check_not_adots_tracked
  check_file "source registry" "$MY_ROOT/config/sources.yml"
  check_dir "context engine" "$MY_ROOT/context-engine"
  check_dir "private Obsidian vault" "$MY_ROOT/vaults/personal"
  check_dir "archive root" "$MY_ROOT/.archive"

  if [[ -d "$MY_ROOT/vaults/public" ]]; then
    record ok "public-safe Obsidian vault" "$MY_ROOT/vaults/public"
  elif [[ "$STRICT_PUBLIC_VAULT" -eq 1 ]]; then
    record fail "public-safe Obsidian vault missing" "$MY_ROOT/vaults/public"
  elif source_registry_defers_public_vault; then
    record warn "public-safe Obsidian vault deferred" "$MY_ROOT/vaults/public" "sources.yml marks my.vault.public as planned"
  else
    record warn "public-safe Obsidian vault missing" "$MY_ROOT/vaults/public" "no planned deferral found in sources.yml"
  fi

  if [[ "$JSON_MODE" -eq 1 ]]; then
    emit_json
  else
    printf 'adots-my: summary: %d passed, %d warning(s), %d failure(s)\n' "$passes" "$warnings" "$failures"
  fi

  [[ "$failures" -eq 0 ]]
}

cmd="${1:-doctor}"
case "$cmd" in
  doctor)
    shift || true
    ;;
  prepare)
    shift || true
    ;;
  migrate)
    shift || true
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    printf 'adots-my: unknown command: %s\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --my-root)
      [[ $# -ge 2 ]] || { printf 'adots-my: --my-root requires a path\n' >&2; exit 2; }
      MY_ROOT="$2"
      shift 2
      ;;
    --strict-public-vault)
      [[ "$cmd" == doctor ]] || { printf 'adots-my: --strict-public-vault only applies to doctor\n' >&2; exit 2; }
      STRICT_PUBLIC_VAULT=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --apply)
      APPLY=1
      shift
      ;;
    --json)
      [[ "$cmd" == doctor ]] || { printf 'adots-my: --json only applies to doctor for now\n' >&2; exit 2; }
      JSON_MODE=1
      shift
      ;;
    -q|--quiet)
      QUIET=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'adots-my: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$cmd" in
  doctor) doctor ;;
  prepare) run_prepare ;;
  migrate) run_migrate ;;
esac
